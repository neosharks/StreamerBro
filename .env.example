# Streamer Bro configuration — copy to ".env"

# HTTP port
PORT=8080

# Where your videos live (downloads are saved here too) and where data is stored
MEDIA_DIR=./media
DATA_DIR=./data

# ---- Metadata (optional but recommended) ----
# Posters, backdrops, plot, cast, genres, IMDB id — get a free TMDB key:
#   https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional: authoritative IMDB ratings via OMDb (free key):
#   https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ---- External tools (override only if not on PATH) ----
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp

# ---- Self-update ----
# Raw URL to a VERSION file used for the "update available" check
# VERSION_URL=https://raw.githubusercontent.com/neosharks/StreamerBro/main/VERSION
