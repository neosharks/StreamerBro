# Streamer Bro configuration — copy to ".env"

# HTTP port
PORT=8080

# Where your videos live (downloads are saved here too) and where data is stored
MEDIA_DIR=./media
DATA_DIR=./data

# ---- Metadata ----
# IMDB metadata (title, year, IMDB rating, plot, genres, cast, poster, backdrop)
# works WITH NO KEY via Cinemeta (IMDB-based). Keys below are optional enrichment:
#   TMDB → higher-res artwork + cast photos + TV shows   https://www.themoviedb.org/settings/api
TMDB_API_KEY=
#   OMDb → authoritative IMDB rating                     https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Set YTS=0 to disable the extra keyless movie fallback
# YTS=1

# ---- External tools (override only if not on PATH) ----
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp

# ---- Playback / transcoding ----
# Files are streamed at full original quality via HTTP range (no re-encode).
# Browser-incompatible containers (MKV) are REMUXED (stream-copied, zero loss).
# Only codecs the browser can't decode (HEVC/x265) are actually re-encoded — for
# smooth 4K on those, enable hardware acceleration if your server has a GPU:
#   FFMPEG_HWACCEL=none        # none | videotoolbox | nvenc | qsv | vaapi
#   TRANSCODE_PRESET=veryfast  # x264 preset when re-encoding on CPU
#   TRANSCODE_CRF=20           # lower = higher quality/bigger (18–23 typical)

# ---- Self-update ----
# Raw URL to a VERSION file used for the "update available" check
# VERSION_URL=https://raw.githubusercontent.com/neosharks/StreamerBro/main/VERSION
