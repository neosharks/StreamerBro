{
  "name": "streamer-bro",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Streamer Bro — self-hosted media streamer with torrent + yt-dlp ingest and TMDB/IMDB metadata",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:web": "cd web && npm install && npm run build",
    "setup": "npm install && npm run build:web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.11.0",
    "webtorrent": "^3.0.21"
  }
}
